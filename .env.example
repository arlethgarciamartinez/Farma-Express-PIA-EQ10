# Copia a .env y ajusta. NUNCA subas .env al repositorio (12-Factor: config en el entorno).
APP_ENV=development
LOG_LEVEL=INFO
APP_PORT=8000

# PostgreSQL (docker compose)
POSTGRES_USER=farma
POSTGRES_PASSWORD=cambia-esta-clave
POSTGRES_DB=farmaexpress
POSTGRES_TEST_DB=farmaexpress_test

# Ejecución local sin Docker (SQLite). En compose se sobreescribe hacia el servicio db.
DATABASE_URL=sqlite:///./farmaexpress.db

# Crear tablas al arrancar y cargar los CSV de datos/ si la BD está vacía
AUTO_CREATE_SCHEMA=true
SEED_ON_STARTUP=true
DATA_DIR=datos
